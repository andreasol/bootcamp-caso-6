# Copy to .env.local and fill in. Never commit .env.local.

# Public (safe in the browser; RLS protects the data, not these keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only, LOCAL SCRIPTS ONLY (scripts/seed.ts, scripts/pipeline.ts).
# Do NOT add this one to Vercel. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Local scripts only (npm run db:push). The pooler host is IPv4; see Supabase > Connect.
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=aws-0-us-east-1.pooler.supabase.com

# Server-only (Phase 2). Never prefix with NEXT_PUBLIC_.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_MS=50000
